{
  "env": {
    "backend": "native_mujoco_cpu",
    "physics_backend": "mjbatch",
    "task": "jump",
    "terrain_idx": 12,
    "pushes": true,
    "seed": 42,
    "physics_workers": 16,
    "geometry": "fitted",
    "jump_actuation": "flow_rebound_jump_v6",
    "jump_height_range_m": [
      0.1,
      0.5
    ],
    "jump_objective": "event_height_efficiency_and_continuous_rebound",
    "update_device": "mps",
    "init_checkpoint": "/Users/yhzhu/Documents/myWorks/exolimb_moon_mujoco_playground/logs/cpu_train/2026-11-18_18-15-44_232619/model_359.pt"
  },
  "runner": {
    "num_steps_per_env": 32,
    "save_interval": 25,
    "logger": "tensorboard",
    "obs_groups": {
      "actor": [
        "policy"
      ],
      "critic": [
        "critic"
      ]
    },
    "actor": {
      "class_name": "rsl_rl.models.MLPModel",
      "hidden_dims": [
        128,
        128
      ],
      "activation": "elu",
      "obs_normalization": true,
      "distribution_cfg": {
        "class_name": "rsl_rl.modules.GaussianDistribution",
        "init_std": 0.25,
        "std_type": "scalar"
      }
    },
    "critic": {
      "class_name": "rsl_rl.models.MLPModel",
      "hidden_dims": [
        128,
        128
      ],
      "activation": "elu",
      "obs_normalization": true
    },
    "algorithm": {
      "class_name": "cpu_sampling_ppo.CpuSamplingMpsPPO",
      "num_learning_epochs": 5,
      "num_mini_batches": 4,
      "learning_rate": 0.0003,
      "schedule": "adaptive",
      "gamma": 0.995,
      "lam": 0.95,
      "entropy_coef": 0.001,
      "desired_kl": 0.01,
      "clip_param": 0.2,
      "max_grad_norm": 1.0,
      "value_loss_coef": 1.0,
      "use_clipped_value_loss": true,
      "normalize_advantage_per_mini_batch": false
    }
  },
  "iterations": 150,
  "torch_threads": 4
}
